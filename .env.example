# Copy to .env.local and fill in. Never commit real keys.
# For EAS cloud builds, set these as EAS environment variables instead.

# --- Build-time (used in app.config.ts) ---
APP_BUNDLE_ID=com.oversizedparking.app
GOOGLE_MAPS_ANDROID_API_KEY=
ADMOB_IOS_APP_ID=
ADMOB_ANDROID_APP_ID=

# --- Runtime (bundled into the app; must start with EXPO_PUBLIC_) ---
EXPO_PUBLIC_CONTACT_EMAIL=support@example.com
EXPO_PUBLIC_PRIVACY_POLICY_URL=https://example.com/privacy

# Supabase project for shared driver reports (Project settings > API).
# The anon key is meant to be public; the database rules protect the data.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# RevenueCat public SDK keys (Project settings > API keys)
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=

# AdMob ad unit IDs. Leave blank to use Google's test ads.
EXPO_PUBLIC_ADMOB_BANNER_IOS=
EXPO_PUBLIC_ADMOB_BANNER_ANDROID=
EXPO_PUBLIC_ADMOB_INTERSTITIAL_IOS=
EXPO_PUBLIC_ADMOB_INTERSTITIAL_ANDROID=

# Optional: your own Overpass server(s) and geocoder for production traffic.
# EXPO_PUBLIC_OVERPASS_URLS=https://overpass.example.com/api/interpreter
# EXPO_PUBLIC_GEOCODER_URL=https://geocoder.example.com/search
